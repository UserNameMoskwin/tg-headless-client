# Telegram API credentials — get from https://my.telegram.org/apps
TG_API_ID=123456
TG_API_HASH=your_telegram_api_hash
TG_PHONE=+1234567890

# Optional: only if you have 2FA enabled
# TG_2FA_PASSWORD=your_2fa_password

# Control bot — create via @BotFather
CONTROL_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
ALLOWED_TELEGRAM_USER_ID=123456789

# Optional settings (defaults shown)
# TG_SESSION=./data/telegram.session
# DB_PATH=./data/telegram.sqlite3
# LOCAL_TIMEZONE=Asia/Tbilisi
# SKIP_ARCHIVED=true
# LOG_LEVEL=INFO
